---
layout: base.liquid
pagination:
  data: series
  size: 1
  alias: s
  resolve: values
permalink: "/series/{{ s.slug }}/"
eleventyComputed:
  title: "{{ s.title }} | Yomimi"
---
<a href="/">← Back to all series</a>
<h1>{{ s.title }}</h1>
<h2>{{ s.titleEnglish }}</h2>
<img src="{{ s.thumbnail }}" alt="Thumbnail for {{ s.title }}">
<p>
  The page and volume numbers are for the following ISBN13s:
  {% for s in s.volumes %}
    {{ s.ISBN13 }} (Vol. {{ s.number }}){% unless forloop.last %},{% endunless %}
  {% endfor -%}
  .
</p>

<table>
  <thead>
    <tr>
      <th>Episode</th>
      <th>Last Page</th>
      <th>Pages</th>
    </tr>
  </thead>
  <tbody>
    {% for ep in s.episodes %}
      <tr>
        <td>{{ ep.number }}</td>
        <td>
          {% if ep.pages == empty %}
            -
          {% else %}
            {% assign lastEntry = ep.pages | last -%}
            {%- assign lastRange = lastEntry.ranges | last %}v{{ lastEntry.volume }} p
            {{- lastRange | last }}
          {% endif %}
        </td>
        <td>
          {% if ep.pages != empty %}
            Main pages:
            {% for p in ep.pages %}
              {%- unless forloop.first %}, {% endunless -%}
              Vol. {{ p.volume }}
              {% for r in p.ranges %}
                p{{ r | join: '-' }}
                {%- unless forloop.last %},{%- endunless %}
              {% endfor %}
            {% endfor -%}
          {% endif -%}
          {% if ep.inessentialPages and ep.inessentialPages != empty %}
            {% if ep.pages != empty %}<br>{% endif %}
            Inessential pages:
            {% for p in ep.inessentialPages %}
              {%- unless forloop.first %}, {% endunless -%}
              Vol. {{ p.volume }}
              {% for r in p.ranges %}
                p{{ r | join: '-' }}
                {%- unless forloop.last %},{%- endunless %}
              {% endfor %}
            {% endfor -%}
          {% endif -%}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>
