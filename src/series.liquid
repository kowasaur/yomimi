---
layout: base.liquid
pagination:
  data: series
  size: 1
  alias: s
  resolve: values
permalink: "/series/{{ s.slug }}/"
eleventyComputed:
  title: "{{ s.title }} | Yomimi"
---
<a href="/">← Back to all series</a>
<h1>{{ s.title }}</h1>
<h2>{{ s.titleEnglish }}</h2>
<img src="{{ s.thumbnail }}" alt="Thumbnail for {{ s.title }}">
<p>
  The page and volume numbers are for the following ISBN13s:
  {% for s in s.volumes %}
    {{ s.ISBN13 }} (Vol. {{ s.number }}){% unless forloop.last %},{% endunless %}
  {% endfor -%}
  .
</p>

<input type="checkbox" id="include-inessential">
<label for="include-inessential">Include inessential pages in Last Page</label>

<table>
  <thead>
    <tr>
      <th>Episode</th>
      <th>Last Page</th>
      <th>Pages</th>
    </tr>
  </thead>
  <tbody>
    {% for ep in s.episodes %}
      <tr>
        <td>{{ ep.number }}</td>
        <td class="last-page-default">
          {% if ep.pages == empty %}
            -
          {% else %}
            {% assign lastEntry = ep.pages | last -%}
            {%- assign lastRange = lastEntry.ranges | last %}
            v{{ lastEntry.volume }} p
            {{- lastRange | last }}
          {% endif %}
        </td>
        <td class="last-page-inessential">
          {% assign hasPages = false %}
          {% assign hasInessential = false %}
          {% if ep.pages != empty %}{% assign hasPages = true %}{% endif %}
          {% if ep.inessentialPages and ep.inessentialPages != empty %}{% assign hasInessential = true %}{% endif %}
          {% if hasPages %}
            {% assign pLast = ep.pages | last %}
            {% assign pLastRange = pLast.ranges | last %}
            {% assign pLastPage = pLastRange | last %}
            {% assign pLastVol = pLast.volume %}
          {% endif %}
          {% if hasInessential %}
            {% assign iLast = ep.inessentialPages | last %}
            {% assign iLastRange = iLast.ranges | last %}
            {% assign iLastPage = iLastRange | last %}
            {% assign iLastVol = iLast.volume %}
          {% endif %}
          {% if hasPages and hasInessential %}
            {% if iLastVol > pLastVol or iLastVol == pLastVol and iLastPage > pLastPage %}
              v{{ iLastVol }} p{{ iLastPage }}
            {% else %}
              v{{ pLastVol }} p{{ pLastPage }}
            {% endif %}
          {% elsif hasInessential %}
            v{{ iLastVol }} p{{ iLastPage }}
          {% elsif hasPages %}
            v{{ pLastVol }} p{{ pLastPage }}
          {% else %}
            -
          {% endif %}
        </td>
        <td>
          {% if ep.pages != empty %}
            Main pages:
            {% for p in ep.pages %}
              {%- unless forloop.first %}, {% endunless -%}
              Vol. {{ p.volume }}
              {% for r in p.ranges %}
                p{{ r | join: '-' }}
                {%- unless forloop.last %},{%- endunless %}
              {% endfor %}
            {% endfor -%}
          {% endif -%}
          {% if ep.inessentialPages and ep.inessentialPages != empty %}
            {% if ep.pages != empty %}<br>{% endif %}
            Inessential pages:
            {% for p in ep.inessentialPages %}
              {%- unless forloop.first %}, {% endunless -%}
              Vol. {{ p.volume }}
              {% for r in p.ranges %}
                p{{ r | join: '-' }}
                {%- unless forloop.last %},{%- endunless %}
              {% endfor %}
            {% endfor -%}
          {% endif -%}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>
