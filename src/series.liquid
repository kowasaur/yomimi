---
layout: base.liquid
pagination:
  data: series
  size: 1
  alias: s
  resolve: values
permalink: "/series/{{ s.slug }}/"
eleventyComputed:
  title: "{{ s.title }} | Yomimi"
---
<a href="/">← Back to all series</a>
<h1>{{ s.title }}</h1>
<h2>{{ s.titleEnglish }}</h2>
<img src="{{ s.thumbnail }}" alt="Thumbnail for {{ s.title }}">
<p>
  The page and volume numbers are for the following ISBN13s:
  {% for s in s.volumes %}
    {{ s.ISBN13 }} (Vol. {{ s.number }}){% unless forloop.last %},{% endunless %}
  {% endfor -%}
  .
</p>

<input type="checkbox" id="include-inessential" oninput="calculateEpisode(); calculatePage()">
<label for="include-inessential">
  Include inessential pages in calcuations (affects Last Page and below calculators)
</label>

<label for="episode-calc-volume">Volume</label>
<input
  type="number"
  placeholder="1"
  step="1"
  id="episode-calc-volume"
  oninput="calculateEpisode()"
>
<label for="episode-calc-page">Page</label>
<input
  type="number"
  placeholder="1"
  step="1"
  id="episode-calc-page"
  oninput="calculateEpisode()"
>
<label for="episode-calc-result">Episode you can watch up to</label>
<output id="episode-calc-result" for="episode-calc-volume episode-calc-page"></output>

<label for="page-calc-episode">Episode</label>
<input
  type="number"
  placeholder="1"
  step="1"
  id="page-calc-episode"
  oninput="calculatePage()"
>
<label for="page-calc-result">Page you have to read up to watch up to this episode</label>
<output id="page-calc-result" for="page-calc-episode"></output>

<table>
  <thead>
    <tr>
      <th>Episode</th>
      <th>Last Page</th>
      <th>Pages</th>
    </tr>
  </thead>
  <tbody>
    {% for ep in s.episodes %}
      <tr>
        <td>{{ ep.number }}</td>
        <td class="last-page-default">
          {% if ep.pages == empty %}
            -
          {% else %}
            {% assign lastEntry = ep.pages | last -%}
            {%- assign lastRange = lastEntry.ranges | last %}
            v{{ lastEntry.volume }} p
            {{- lastRange | last }}
          {% endif %}
        </td>
        <td class="last-page-inessential">
          {% assign hasPages = false %}
          {% assign hasInessential = false %}
          {% if ep.pages != empty %}{% assign hasPages = true %}{% endif %}
          {% if ep.inessentialPages and ep.inessentialPages != empty -%}
            {%- assign hasInessential = true -%}
          {%- endif %}
          {% if hasPages %}
            {% assign pLast = ep.pages | last %}
            {% assign pLastRange = pLast.ranges | last %}
            {% assign pLastPage = pLastRange | last %}
            {% assign pLastVol = pLast.volume %}
          {% endif %}
          {% if hasInessential %}
            {% assign iLast = ep.inessentialPages | last %}
            {% assign iLastRange = iLast.ranges | last %}
            {% assign iLastPage = iLastRange | last %}
            {% assign iLastVol = iLast.volume %}
          {% endif %}
          {% if hasPages and hasInessential %}
            {% if iLastVol > pLastVol or iLastVol == pLastVol and iLastPage > pLastPage %}
              v{{ iLastVol }} p{{ iLastPage }}
            {% else %}
              v{{ pLastVol }} p{{ pLastPage }}
            {% endif %}
          {% elsif hasInessential %}
            v{{ iLastVol }} p{{ iLastPage }}
          {% elsif hasPages %}
            v{{ pLastVol }} p{{ pLastPage }}
          {% else %}
            -
          {% endif %}
        </td>
        <td>
          {% if ep.pages != empty %}
            Main pages:
            {% for p in ep.pages %}
              {%- unless forloop.first %}, {% endunless -%}
              Vol. {{ p.volume }}
              {% for r in p.ranges %}
                p{{ r | join: '-' }}
                {%- unless forloop.last %},{%- endunless %}
              {% endfor %}
            {% endfor -%}
          {% endif -%}
          {% if ep.inessentialPages and ep.inessentialPages != empty %}
            {% if ep.pages != empty %}<br>{% endif %}
            Inessential pages:
            {% for p in ep.inessentialPages %}
              {%- unless forloop.first %}, {% endunless -%}
              Vol. {{ p.volume }}
              {% for r in p.ranges %}
                p{{ r | join: '-' }}
                {%- unless forloop.last %},{%- endunless %}
              {% endfor %}
            {% endfor -%}
          {% endif -%}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>

<script>
  const episodes = {{ s.episodes | jsonify }};
  const lastPages = makeMonotoneIncreasing(episodes.map(ep => {
    if (!ep.pages || ep.pages.length == 0) {
      return {"volume": 0, "page": 0};
    }
    const lastVolPage = ep.pages.at(-1);
    return {
      "volume": lastVolPage.volume,
      "page": lastVolPage.ranges.at(-1).at(-1)
    };
  }));
  const lastAllPages = makeMonotoneIncreasing(episodes.map((ep, i) => {
    const lastVolInPage = ep.inessentialPages?.at(-1);
    const main = lastPages[i];
    if (!lastVolInPage) {
      return main;
    }
    const inessential = {
      "volume": lastVolInPage.volume,
      "page": lastVolInPage.ranges.at(-1).at(-1)
    };
    return maxVolPage(main, inessential);
  }));

  const includeInessentialCheckbox = document.getElementById("include-inessential");

  function volGreater(a, b) {
    return a.volume > b.volume || (a.volume == b.volume && a.page > b.page);
  }

  function maxVolPage(a, b) {
    return volGreater(a, b) ? a : b;
  }

  function makeMonotoneIncreasing(arr) {
    for (let i = 1; i < arr.length; i++) {
      arr[i] = maxVolPage(arr[i], arr[i - 1]);
    }
    return arr;
  }

  function getLastPage(episodeIndex) {
    return includeInessentialCheckbox.checked ? lastAllPages[episodeIndex] : lastPages[episodeIndex];
  }

  function invalidNumber(n) {
    return isNaN(n) || n < 1 || !Number.isInteger(n);
  }

  function calculateEpisode() {
    const volumeInput = document.getElementById("episode-calc-volume");
    const pageInput = document.getElementById("episode-calc-page");
    const resultOutput = document.getElementById("episode-calc-result");
    const volume = volumeInput.valueAsNumber;
    const page = pageInput.valueAsNumber;

    if (invalidNumber(volume) || invalidNumber(page)) {
      resultOutput.value = "";
      return;
    }

    for (let i = 0; i < episodes.length; i++) {
      const lastPage = getLastPage(i);
      if (volGreater(lastPage, {"volume": volume, "page": page})) {
        resultOutput.value = episodes[i].number - 1;
        if (resultOutput.value == 0) {
          resultOutput.value = "None";
        }
        return;
      }
    }
    resultOutput.value = episodes.length;
  }

  function calculatePage() {
    const episodeInput = document.getElementById("page-calc-episode");
    const resultOutput = document.getElementById("page-calc-result");
    const episode = episodeInput.valueAsNumber;

    if (invalidNumber(episode) || episode > episodes.length) {
      resultOutput.value = "";
      return;
    }

    const page = getLastPage(episode - 1);
    resultOutput.value = `Volume ${page.volume} Page ${page.page}`;
  }
</script>
