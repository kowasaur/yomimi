---
layout: base.liquid
pagination:
  data: series
  size: 1
  alias: s
  resolve: values
permalink: "/series/{{ s.slug }}/"
eleventyComputed:
  title: "{{ s.title }} | Yomimi"
---
<a href="/">← Back to all series</a>
<h1>{{ s.title }}</h1>
<h2>{{ s.titleEnglish }}</h2>
<img src="{{ s.thumbnail }}" alt="Thumbnail for {{ s.title }}">
<p>
  The page and volume numbers are for the following ISBN13s:
  {% for s in s.volumes %}
    {{ s.ISBN13 }} (vol. {{ s.number }}){% unless forloop.last %},{% endunless %}
  {% endfor -%}
  .
</p>

<h2>Episodes</h2>
<table>
  <thead>
    <tr>
      <th>Episode</th>
      <th>Last Page</th>
    </tr>
  </thead>
  <tbody>
    {% for ep in s.episodes %}
      <tr>
        <td>{{ ep.number }}</td>
        <td>
          {% assign lastPage = ep.pages | last %}v{{ lastPage.volume }} p{{ lastPage.range | last }}
        </td>
      </tr>
    {% endfor %}
  </tbody>
</table>
